# =============================================================================
# Content Understanding Configuration
# =============================================================================

# Azure AI Content Understanding endpoint (no trailing slash)
# Find this in Azure Portal > Your AI Services resource > Keys and Endpoint
AZURE_AI_ENDPOINT=https://your-resource.cognitiveservices.azure.com

# Azure AI API Key
# Find this in Azure Portal > Your AI Services resource > Keys and Endpoint
AZURE_AI_API_KEY=your-api-key-here

# CU API Version (optional - defaults to 2025-11-01 GA)
# CU_API_VERSION=2025-11-01

# =============================================================================
# HTTP Test Files (CU_API_Testing folder)
# =============================================================================

# These are used by the .http REST Client files
ENDPOINT_URL=https://your-resource.cognitiveservices.azure.com
API_KEY=your-api-key-here

# =============================================================================
# Optional: Azure OpenAI (for advanced tools like review_file)
# =============================================================================

# AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4

# GPT-4.1 deployment (required for prebuilt-invoice, prebuilt-receipt, etc.)
# GPT_4_1_DEPLOYMENT=gpt-4.1

# GPT-4.1-mini deployment (required for prebuilt-documentSearch, etc.)
# GPT_4_1_MINI_DEPLOYMENT=gpt-4.1-mini

# Text-embedding-3-large deployment (required for search analyzers)
# TEXT_EMBEDDING_3_LARGE_DEPLOYMENT=text-embedding-3-large
