{
  "simple_document": {
    "analyzerId": "my-doc-analyzer",
    "properties": {
      "scenario": "document",
      "description": "Simple document analyzer",
      "status": "ready",
      "fieldSchema": {
        "fields": {
          "InvoiceNumber": { "type": "string" },
          "Total": { "type": "number" }
        }
      },
      "tags": { "team": "finance" }
    }
  },
  "with_training_data": {
    "analyzerId": "my-custom-analyzer",
    "properties": {
