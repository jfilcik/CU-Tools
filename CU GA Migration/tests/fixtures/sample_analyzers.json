      "status": "ready",
      "fieldSchema": {
        "fields": {
          "ClaimNumber": { "type": "string" }
        }
      },
      "trainingData": {
        "blobContainerUrl": "https://mystorage.blob.core.windows.net/training-data",
        "prefix": "claims/",
        "fieldMappings": [
          { "fieldId": "ClaimNumber", "label": "Claim Number" }
        ]
      },
      "tags": { "team": "claims" }
    }
  },
  "with_pro_mode": {
